# Local demo preview on this machine (simulated rooms + devices)
MATTERHUB_SYSTEM_MODE=mock
MATTERHUB_SMART_HOME_BACKEND=demo
# The UI toggle in Settings > Demo Mode also forces demo at runtime.
# MATTERHUB_DEMO_SETTINGS_FILE=./.tmp/demo-settings.json

# Switch these on when validating against a real Home Assistant instance
# MATTERHUB_HOME_ASSISTANT_URL=http://127.0.0.1:8123
# MATTERHUB_HOME_ASSISTANT_TOKEN=
# MATTERHUB_HOME_ASSISTANT_TOKEN_FILE=

# Override only when validating on real Pi hardware
# MATTERHUB_SYSTEM_MODE=hardware
# MATTERHUB_AUDIO_TEST_LOG_FILE=/opt/matterhub/.tmp/audio-test-events.jsonl
# MATTERHUB_VOICE_CAPTURE_DEVICE=plughw:1,0
# MATTERHUB_VOICE_PLAYBACK_DEVICE=plughw:1,0
# MATTERHUB_VOICE_SILENCE_RMS_THRESHOLD=240
# MATTERHUB_VOICE_SILENCE_DURATION_MS=1800
# MATTERHUB_VOICE_TARGET_RMS=7000
# MATTERHUB_VOICE_MIN_GAIN=4
# MATTERHUB_VOICE_MAX_GAIN=40
# MATTERHUB_DISPLAY_BRIGHTNESS_PATH=/sys/class/backlight/10-0045/brightness
# MATTERHUB_DISPLAY_ACTUAL_BRIGHTNESS_PATH=/sys/class/backlight/10-0045/actual_brightness
# MATTERHUB_DISPLAY_MAX_BRIGHTNESS_PATH=/sys/class/backlight/10-0045/max_brightness
# MATTERHUB_WIFI_INTERFACE=wlan0
# MATTERHUB_WIFI_COMMAND_PREFIX=sudo
# MATTERHUB_WIFI_COMMAND_TIMEOUT=15000
