#!/bin/sh

# Wait for MatterHub server, then launch Chromium kiosk
# Keep Chromium on kiosk/UI duty only.
# Do not add deprecated primary-audio routing flags such as
# --alsa-input-device or --alsa-output-device here; Phase 1 audio
# ownership lives in the host OS helpers/config instead.
/usr/bin/sh -lc 'for i in $(seq 1 60); do systemctl is-active --quiet matterhub && break; sleep 1; done; exec chromium --ozone-platform=wayland --enable-features=UseOzonePlatform,OverlayScrollbar --kiosk --noerrdialogs --disable-infobars --no-first-run --start-maximized http://127.0.0.1:3000' &
