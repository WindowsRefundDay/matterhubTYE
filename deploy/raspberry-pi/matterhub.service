[Unit]
Description=MatterHub Next.js standalone server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=matter
Group=matter
WorkingDirectory=/opt/matterhub
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=MATTERHUB_HOME_ASSISTANT_TOKEN_FILE=/etc/matterhub/ha.token
Environment=MATTERHUB_HOME_ASSISTANT_URL=http://127.0.0.1:8123
Environment=MATTERHUB_AUDIO_MIXER_CONTROL=PCM
ExecStart=/usr/bin/node /opt/matterhub/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
